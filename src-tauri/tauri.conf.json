{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentPulse",
  "version": "0.1.0",
  "identifier": "com.agentpulse.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm run dev:renderer",
    "beforeBuildCommand": "pnpm run build:renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "externalBin": [
      "binaries/agentpulse-hook"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdDRDlBOUUxRENFOTRGOTcKUldTWFQrbmM0YW5aZkRaYjVPMXZjUTBkaXpQRnlPeGJISXNYdWFmbEZ6S0xyTzJlN1AzeDFkMloK",
      "endpoints": [
        "https://github.com/Q1ngSong/AgentPulse/releases/latest/download/latest.json"
      ]
    }
  }
}
